# ================================================================
# Enterprise RAG Intelligence Platform - Environment Variables
# ================================================================

# Groq LLM API Configuration
# Get your API key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# NVIDIA Embeddings API Configuration
# Get your API key at: https://build.nvidia.com/
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_EMBED_MODEL=nvidia/nv-embedqa-e5-v5

# Storage & Indexing Paths
FAISS_INDEX_PATH=backend/data/vector_index
UPLOAD_DIR=backend/data/uploads

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Retrieval & Guardrail Defaults
TOP_K_RETRIEVAL=10
TOP_N_RERANK=4
MIN_RELEVANCE_SCORE=0.35
